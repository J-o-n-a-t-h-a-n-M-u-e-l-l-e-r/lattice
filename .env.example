# =============================================================================
#  BACKEND  (apps/backend) — pipeline, store, REST API, MCP
# =============================================================================

# Postgres. Neon's free tier is plenty.
DATABASE_URL=

# A GitHub token with READ access to issues. Lattice never writes to GitHub,
# so no write scopes are needed — except for Copilot dispatch, which is the one
# write in the project and requires a USER token (PAT or GitHub App
# user-to-server) with read+write on actions, contents, issues, pull requests.
GITHUB_TOKEN=

# The repo Lattice analyses.
LATTICE_OWNER=
LATTICE_REPO=

# --- Inference (OpenRouter) --------------------------------------------------
# https://openrouter.ai/keys   Buy $10 of credits: it lifts the free-model quota
# from 50 to 1000 requests/day. See docs/10-model-provider.md.
OPENROUTER_API_KEY=

# Ox Alpha: free, 1M context. A STEALTH PREVIEW model that can be withdrawn
# without notice — this is an env var so swapping providers is a config change.
LATTICE_MODEL=stealth/ox-alpha
LATTICE_MODEL_BASE_URL=https://openrouter.ai/api/v1

# 0 = send the whole backlog in one call (recommended for n <= 40, given the
# 1M context window). Any other value caps issues per cluster.
LATTICE_CLUSTER_SIZE=0

# Edges at or above this score constrain the schedule. Lower-confidence edges
# are still stored and drawn — they just don't block anything.
LATTICE_BLOCK_THRESHOLD=0.80

# --- Auth --------------------------------------------------------------------
# Bearer token the REST API expects. apps/web needs this and nothing else.
LATTICE_API_TOKEN=

# Bearer token the MCP server expects. Must be named COPILOT_MCP_* for Copilot
# to reference it from the repo's MCP configuration.
COPILOT_MCP_LATTICE_TOKEN=

# GitHub webhook signing secret.
GITHUB_WEBHOOK_SECRET=

# =============================================================================
#  WEB  (apps/web) — the interactive graph. Two variables, deliberately.
#  No database URL, no GitHub token, no model key.
# =============================================================================

NEXT_PUBLIC_LATTICE_API_URL=http://localhost:3001
LATTICE_API_TOKEN=

# =============================================================================
#  Both
# =============================================================================
# 1 = run entirely from committed fixtures: no database, no credentials.
DEMO_MODE=0
