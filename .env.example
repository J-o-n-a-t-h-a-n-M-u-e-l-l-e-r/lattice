# ---- GitHub ----------------------------------------------------------------
# A USER token (classic with `repo`, or fine-grained with read+write on
# actions, contents, issues, pull requests). An installation token will NOT
# work for Copilot assignment.
GITHUB_TOKEN=

# The repo Lattice analyses. Defaults to this repo.
LATTICE_OWNER=
LATTICE_REPO=

# ---- Inference -------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- MCP -------------------------------------------------------------------
# Bearer token the MCP server expects. Must be named COPILOT_MCP_* for Copilot
# to be able to reference it from the repo's MCP configuration.
COPILOT_MCP_LATTICE_TOKEN=

# ---- Demo ------------------------------------------------------------------
# Set to 1 to run the whole app from committed fixtures with no tokens at all.
DEMO_MODE=0
