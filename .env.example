# ---- GitHub ----------------------------------------------------------------
# A USER token (classic with `repo`, or fine-grained with read+write on
# actions, contents, issues, pull requests). An installation token will NOT
# work for Copilot assignment.
GITHUB_TOKEN=

# The repo Lattice analyses. Defaults to this repo.
LATTICE_OWNER=
LATTICE_REPO=

# ---- Inference (OpenRouter) ------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ox Alpha: free, 1M context, OpenAI-compatible. It is a STEALTH PREVIEW model
# and can be withdrawn without notice — this is an env var precisely so that
# swapping providers is a config change, not a code change.
# See docs/10-model-provider.md.
LATTICE_MODEL=stealth/ox-alpha
LATTICE_MODEL_BASE_URL=https://openrouter.ai/api/v1

# 0 = send the whole backlog in one call (recommended for n <= 40, given the
# 1M context window). Any other value caps issues per cluster.
LATTICE_CLUSTER_SIZE=0

# ---- MCP -------------------------------------------------------------------
# Bearer token the MCP server expects. Must be named COPILOT_MCP_* for Copilot
# to be able to reference it from the repo's MCP configuration.
COPILOT_MCP_LATTICE_TOKEN=

# ---- Demo ------------------------------------------------------------------
# Set to 1 to run the whole app from committed fixtures with no tokens at all.
DEMO_MODE=0
